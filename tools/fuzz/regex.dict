# Regular expression syntax for the fuzzer's mutations.
"("
")"
"(?:"
"(?="
"(?!"
"(?<="
"(?<!"
"(?<n>"
"(?P<n>"
"(?&n)"
"(?R)"
"(?|"
"(?i)"
"(?x)"
"(*UTF)"
"(*UCP)"
"(*COMMIT)"
"(*SKIP)"
"(*MARK:x)"
"[^"
"[[:alpha:]]"
"\\d"
"\\w"
"\\s"
"\\b"
"\\K"
"\\p{L}"
"\\x{100}"
"\\1"
"\\k<n>"
"\\Q"
"\\E"
"{2,3}"
"*+"
"+?"
"$1"
"${n}"
"${1:-d}"
