# Portable make only: no GNU-make conditionals, no $(shell), no $(wildcard)
# and no -W* or optimisation flags, any of which costs a CRAN rejection or a
# GNU make requirement.
#
# PCRE2 is vendored under vendor/pcre2/ (tools/vendor/manifest.tsv) and built
# here without CMake or configure, as PCRE2's NON-AUTOTOOLS-BUILD describes:
#
#   -DHAVE_CONFIG_H         the vendored units include config.h, which is the
#                           package's own, pcre2-config/config.h
#   -DPCRE2_CODE_UNIT_WIDTH=8
#                           the 8-bit library only; first-party units include
#                           pcre2.h and need it too
#   -DPCRE2_STATIC          linked in, never imported from a DLL: on Windows
#                           pcre2.h would otherwise declare every function
#                           __declspec(dllimport)
#
# tools/vendor/verify checks these defines against the manifest.
PKG_CPPFLAGS = -Ipcre2-config -Ivendor/pcre2/src \
  -DHAVE_CONFIG_H -DPCRE2_CODE_UNIT_WIDTH=8 -DPCRE2_STATIC

# $(C_VISIBILITY) is R's own spelling of -fvisibility=hidden, empty where the
# compiler has no such flag. It keeps every pcre2_* symbol out of the dynamic
# symbol table, so nothing can bind to R's own libpcre2-8, a different version
# (design section 4). R_init_zuregex is marked attribute_visible.
# tests/testthat/test-abi.R checks the installed object.
PKG_CFLAGS = $(C_VISIBILITY)

# The 8-bit library's translation units, as NON-AUTOTOOLS-BUILD lists them.
# sljit has no unit of its own: pcre2_jit_compile.c includes sljitLir.c.
PCRE2_OBJECTS = \
