#!/bin/sh
# Writes src/Makevars from src/Makevars.in, choosing the OpenMP flags, as
# zurand's configure does (design D5).
#
# Everywhere but macOS this is R's $(SHLIB_OPENMP_CFLAGS): set where R was
# built with OpenMP, empty (a serial build) where it was not.
#
# On macOS R leaves SHLIB_OPENMP_CFLAGS empty, because Apple's clang has
# OpenMP support but no runtime. R ships the matching runtime, libomp.dylib
# in $(R_HOME)/lib, and CRAN's build machines add the headers
# (https://mac.r-project.org/openmp/). So build a probe with -Xclang
# -fopenmp and -lomp, load it into R and run it; only if all three work
# use those flags, otherwise build serially. Linking alone proves little:
# macOS links against a flat namespace, so a runtime missing an entry point
# the compiler emits fails only when the package loads (#72), which is why
# data.table's configure runs its probe too. The probe uses the constructs
# phase 2 uses (src/omp.h): a parallel block, omp_get_thread_num() and an
# atomic counter. Results never depend on the thread count, so either
# outcome gives identical results.

: "${R_HOME:=$(R RHOME)}"
if [ -z "${R_HOME}" ]; then
  echo "configure: could not determine R_HOME" >&2
  exit 1
fi

OPENMP_CFLAGS='$(SHLIB_OPENMP_CFLAGS)'
OPENMP_LIBS='$(SHLIB_OPENMP_CFLAGS)'

if [ "$(uname)" = "Darwin" ]; then
  tmp=$(mktemp -d 2>/dev/null || echo "${TMPDIR:-/tmp}/zuregex-omp.$$")
  mkdir -p "$tmp"
  cat > "$tmp/omp.c" <<'CEOF'
#ifndef _OPENMP
#error "_OPENMP is not defined"
#endif
#include <omp.h>
void zuregex_omp_probe(int *out) {
  unsigned int next = 0;
  int sum = 0;
#pragma omp parallel num_threads(2)
  {
    int mine = 0;
    for (unsigned int i = __atomic_fetch_add(&next, 1u, __ATOMIC_RELAXED);
         i < 4u; i = __atomic_fetch_add(&next, 1u, __ATOMIC_RELAXED)) {
      mine += (int) i + 1 + 0 * omp_get_thread_num();
    }
    __atomic_fetch_add(&sum, mine, __ATOMIC_RELAXED);
  }
  *out = sum;
}
CEOF
  printf "%s" "checking whether OpenMP works with -Xclang -fopenmp -lomp... "
  if (cd "$tmp" && PKG_CFLAGS="-Xclang -fopenmp" PKG_LIBS="-lomp" \
        "${R_HOME}/bin/R" CMD SHLIB omp.c > config.log 2>&1 &&
      "${R_HOME}/bin/Rscript" -e '
        dll <- paste0("omp", .Platform$dynlib.ext)
        dyn.load(dll)
        stopifnot(identical(.C("zuregex_omp_probe", out = integer(1))$out, 10L))
      ' >> config.log 2>&1); then
    echo "yes"
    OPENMP_CFLAGS="-Xclang -fopenmp"
    OPENMP_LIBS="-lomp"
  else
    echo "no (building without OpenMP; see https://mac.r-project.org/openmp/)"
  fi
  rm -rf "$tmp"
fi

sed -e "s|@OPENMP_CFLAGS@|${OPENMP_CFLAGS}|" \
    -e "s|@OPENMP_LIBS@|${OPENMP_LIBS}|" \
    src/Makevars.in > src/Makevars
exit 0
